+/* Beep: set from the config file's `general.service_type = "classic";`. Makes an
+ * AirPlay-2 build advertise ONLY classic AirPlay 1 (RAOP) at runtime — no
+ * _airplay._tcp service, no nqptp requirement — so one image can switch AP1/AP2
+ * without a rebuild. Backport of upstream 5.1's service_type onto 4.3.2. */
+static int config_service_type_classic = 0;
 
