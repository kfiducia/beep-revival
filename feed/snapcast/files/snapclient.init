#!/bin/sh /etc/rc.common
# Snapcast client — plays the group's synced stream out the WM8524 via ALSA.
# Enabled/disabled by the Beep multi-room layer (beep-group). Outputs to the ALSA
# "default" PCM, which is our softvol "Master" plug, so the volume knob / web slider
# attenuate the synced stream too. With no server host set, snapclient mDNS-discovers
# the group primary automatically.
USE_PROCD=1
START=95
STOP=10

start_service() {
	local host port soundcard hostid
	config_load beep 2>/dev/null
	config_get host main group_server ""
	config_get port main group_port "1704"
	config_get soundcard main snap_pcm "default"
	config_get hostid main name ""

	procd_open_instance
	procd_set_param command /usr/bin/snapclient --player alsa -s "$soundcard" -p "$port"
	[ -n "$host" ] && procd_append_param command -h "$host"
	[ -n "$hostid" ] && procd_append_param command --hostID "$hostid"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger beep
}
