#!/bin/sh
# Signed OTA endpoint (the ONLY CGI in the image). Two flash paths, by threat model:
#
#   SIGNED   image -> requires a valid admin rpcd session AND a usign signature
#                     against /etc/beep-ota.pub. Safe to allow remotely: a stolen
#                     session still can't forge the signature.
#   UNSIGNED image -> requires a FRESH PHYSICAL triple-tap on the device (a 60s
#                     window in /var/run/beep/phys-confirm, opened by beepd). No
#                     session can substitute. This is the anti-remote-hack gate:
#                     a remotely-compromised device cannot be made to flash
#                     unsigned firmware, because no remote actor can triple-tap.
#
# GET returns {"phys":bool} so the web UI reveals the unsigned option only while
# a physical confirmation is live.
say() { printf 'Status: %s\r\nContent-Type: application/json\r\n\r\n%s\n' "$1" "$2"; }
fail() { rm -f /tmp/ota.bin /tmp/ota.sig; say "$1" "$2"; exit 0; }
# (testability) phys-confirm path is overridable so the unsigned-upload gate can be
# exercised off-device; unset on a unit, so this matches the original hard-coded path.
: "${PHYS_CONFIRM:=/var/run/beep/phys-confirm}"

phys_valid() {
	[ -f "$PHYS_CONFIRM" ] || return 1
	local exp now; exp="$(cat "$PHYS_CONFIRM" 2>/dev/null)"
	now="$(date +%s)"
	case "$exp" in ''|*[!0-9]*) return 1;; esac
	[ "$now" -lt "$exp" ]
}

# --- GET: status for the UI (is a physical override window open?) ---
if [ "$REQUEST_METHOD" = GET ]; then
	if phys_valid; then say '200 OK' '{"phys":true}'; else say '200 OK' '{"phys":false}'; fi
	exit 0
fi
[ "$REQUEST_METHOD" = POST ] || { say '405 Method Not Allowed' '{"error":"POST only"}'; exit 0; }

# --- Auth + signature travel in the QUERY STRING, not custom headers. uhttpd only
# exports standard request headers (Host/User-Agent/...) to CGI — it silently drops
# custom X-* headers — but it DOES pass QUERY_STRING and the request body. So the
# session token and the detached signature come via ?session=&sig=&unsigned=, and the
# image is the raw body. The signature is base64url (-_ for +/, padding stripped) so
# it rides in a URL untouched. The browser splits the single signed .bin (sig lines +
# image) and sends only the image here — no on-device split, so RAM stays ~one image. ---
qs_get() { printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1; }

sess="$(qs_get session)"
sig_b64u="$(qs_get sig)"
want_unsigned=0
[ "$(qs_get unsigned)" = "1" ] && want_unsigned=1

admin=0
case "$sess" in ''|*[!0-9a-fA-F]*) ;; *)
	acc="$(ubus call session access "{\"ubus_rpc_session\":\"$sess\",\"scope\":\"ubus\",\"object\":\"beep\",\"function\":\"reboot\"}" 2>/dev/null | jsonfilter -e '@.access' 2>/dev/null)"
	[ "$acc" = "true" ] && admin=1 ;;
esac

# --- AUTHORIZE BEFORE RECEIVING THE IMAGE. Reading the body first would let an
# unauthenticated caller stream an arbitrarily large POST into /tmp (tmpfs = RAM)
# and exhaust memory before any credential was checked — a pre-auth DoS. Both the
# unsigned flag and the session are in the query, so we decide without a body. ---
if [ "$want_unsigned" = 1 ]; then
	# UNSIGNED: physical presence is mandatory; an admin session is NOT sufficient.
	phys_valid || fail '403 Forbidden' '{"error":"unsigned upload requires a physical triple-tap on the device (within 60s)"}'
else
	# SIGNED: a signature must be supplied AND (on the primary) an admin session held
	# — the signature itself is verified after the body arrives; a stolen session still
	# can't forge it. In the RECOVERY initramfs there is no rpcd/session at all, so the
	# usign signature IS the sole authenticator: a valid signature against the baked
	# pubkey is proof the image is a genuine Beep release, which is exactly what a
	# from-recovery reflash needs. The /etc/beep-recovery marker (present only in the
	# recovery image) waives the session requirement; the signature check below is not
	# waived, so an unsigned image can still never reach sysupgrade this way.
	[ -n "$sig_b64u" ] || fail '400 Bad Request' '{"error":"no signature — upload a signed .bin (or triple-tap for an unsigned install)"}'
	if [ ! -f /etc/beep-recovery ]; then
		[ "$admin" = 1 ] || fail '401 Unauthorized' '{"error":"sign in as admin, or triple-tap the device for an unsigned install"}'
	fi
fi

# --- receive image (raw body), hard-capped. Refuse an over-large Content-Length up
# front, and cap the actual read too so a chunked/omitted length can't exhaust RAM. ---
MAX_BYTES=16777216   # 16 MiB — real sysupgrade images for this board are ~10 MB
case "$CONTENT_LENGTH" in
	''|*[!0-9]*) ;;   # absent/non-numeric (e.g. chunked) — the read cap below still bounds us
	*) [ "$CONTENT_LENGTH" -le "$MAX_BYTES" ] || fail '413 Payload Too Large' '{"error":"image too large"}';;
esac
rm -f /tmp/ota.bin /tmp/ota.sig
head -c "$MAX_BYTES" > /tmp/ota.bin
[ -s /tmp/ota.bin ] || fail '400 Bad Request' '{"error":"empty image"}'

# --- signature verification for the signed path ---
if [ "$want_unsigned" = 1 ]; then
	logger -t beep "OTA: UNSIGNED flash authorized by physical triple-tap"
else
	# base64url -> base64 (restore +/), re-add stripped '=' padding, then decode to
	# the detached usign signature.
	b64="$(printf '%s' "$sig_b64u" | tr '_-' '/+')"
	while [ $(( ${#b64} % 4 )) -ne 0 ]; do b64="${b64}="; done
	printf '%s' "$b64" | base64 -d > /tmp/ota.sig 2>/dev/null || fail '400 Bad Request' '{"error":"bad signature encoding"}'
	usign -V -m /tmp/ota.bin -p /etc/beep-ota.pub -x /tmp/ota.sig >/dev/null 2>&1 \
		|| fail '400 Bad Request' '{"error":"signature verification failed — not a genuine Beep release"}'
fi

# --- sanity: a real sysupgrade image for this board ---
sysupgrade -T /tmp/ota.bin >/dev/null 2>&1 \
	|| fail '400 Bad Request' '{"error":"not a valid firmware image for this device"}'

# --- flash; device reboots. bootb->recovery backstops a bad boot ---
#
# We do NOT use stock keep-config. A stock keep-config sysupgrade preserves ALL of
# /etc/config/* (OpenWrt's base /lib/upgrade/keep.d), so a stale variant config
# (snapcast/shairport/squeezelite) rides onto an image that no longer ships that
# package and the FIRST-BOOT RESTORE HANGS — the exact chain that bricked a unit on
# 2026-09-08 (GitHub #8/#22): a hung restore + no good-boot bootcount reset + a garbage
# recovery pointer escalated to a UART-only brick, while the primary squashfs was 100%
# intact. Instead we hand sysupgrade a CURATED tarball via `-f`, which makes it restore
# ONLY that tar (OpenWrt sysupgrade: `-f` sets CONF_IMAGE, restored verbatim — no broad
# keep.d expansion). The set is identity + connectivity ONLY, no variant-specific
# service config, so a variant mismatch can't hang the restore. Crucially it INCLUDES
# /etc/config/wireless, so the unit rejoins home wifi after the flash — this is why we
# no longer need `-n` (which would strand the unit on the setup AP) and are no longer
# blocked on the setup-AP DHCP fix (PR #18). See docs/RECOVERY-DESIGN.md.
if [ -f /etc/beep-recovery ]; then
	# From-recovery reflash of a primary: there is no owner identity here to keep
	# (recovery is stateless); the fresh primary self-provisions from its MAC via
	# 99-beep. Flash clean so nothing stale can hang first boot.
	FLASH_ARGS="-n"
	logger -t beep "OTA: recovery->primary reflash (clean, -n)"
else
	# Curated preserve. Paths are RELATIVE to / (how sysupgrade's restore untars them),
	# and only files that actually exist are added. Deliberately EXCLUDES
	# /etc/config/{snapcast,shairport,squeezelite,...} and the SSH-enable toggle —
	# anything variant-specific that could trip the restore.
	KEEP=/tmp/beep-keep.tar.gz; rm -f "$KEEP"
	KEEP_FILES=""
	for f in etc/beep-code etc/beep-uhttpd.crt etc/beep-uhttpd.key etc/shadow \
	         etc/config/wireless etc/config/network etc/config/system; do
		[ -e "/$f" ] && KEEP_FILES="$KEEP_FILES $f"
	done
	# shellcheck disable=SC2086  # $KEEP_FILES deliberately word-splits into separate tar paths
	( cd / && tar czf "$KEEP" $KEEP_FILES ) 2>/dev/null
	# NEVER flash into an identity wipe: the tar must exist and carry the device code.
	# If staging failed, abort BEFORE flashing rather than reset the owner's password
	# and TLS cert to factory.
	if [ ! -s "$KEEP" ] || ! tar tzf "$KEEP" 2>/dev/null | grep -q '^etc/beep-code$'; then
		rm -f "$KEEP"
		fail '500 Internal Server Error' '{"error":"could not stage config preserve — flash aborted to protect device identity"}'
	fi
	FLASH_ARGS="-f $KEEP"
	logger -t beep "OTA: curated-preserve flash (-f); keeping:$KEEP_FILES"
fi

say '200 OK' '{"ok":true,"note":"flashing and rebooting"}'
logger -t beep "OTA: starting sysupgrade ($([ "$want_unsigned" = 1 ] && echo unsigned || echo signed), args: $FLASH_ARGS)"
# Detach the flash into its own session with setsid so uhttpd tearing down this CGI's
# process group can't signal sysupgrade MID-WRITE — a half-written primary is exactly
# the brick we're guarding against. Fall back to a plain background if setsid is absent.
# $FLASH_ARGS is intentionally unquoted (word-split into flags; paths carry no spaces).
if command -v setsid >/dev/null 2>&1; then
	setsid sh -c "sleep 1; sysupgrade $FLASH_ARGS /tmp/ota.bin" </dev/null >/dev/null 2>&1 &
else
	# shellcheck disable=SC2086  # $FLASH_ARGS deliberately word-splits into sysupgrade flags
	( sleep 1; sysupgrade $FLASH_ARGS /tmp/ota.bin ) </dev/null >/dev/null 2>&1 &
fi
exit 0
