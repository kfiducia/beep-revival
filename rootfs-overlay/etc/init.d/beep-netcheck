#!/bin/sh /etc/rc.common
# Continuous wifi watchdog (STA up, else Beep-Setup AP). procd-managed so it
# respawns; the loop itself paces the checks.
START=99
USE_PROCD=1
start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/beep/netcheck-loop
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
