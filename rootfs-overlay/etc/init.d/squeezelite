#!/bin/sh /etc/rc.common
# Squeezelite — Lyrion Music Server (LMS / Squeezebox) player for the Beep.
#
# This is a Beep-tailored replacement for the stock OpenWrt squeezelite init
# (the packaged one under /rom). It differs in three deliberate ways, all so a
# Lyrion stream behaves exactly like AirPlay/Snapcast on this device:
#
#   1. -V <mixer_control>: drives the ALSA "Master" softvol control (see
#      /etc/asound.conf) instead of doing squeezelite's own internal software
#      volume. This is the same binding shairport-sync uses (mixer_control_name
#      = "Master"): the LMS app slider, the volume knob, the web slider and the
#      LED arc then all move ONE shared level. The stock init has no -V option,
#      so without this the LMS volume and the knob would be two separate volumes.
#   2. nice -12 via procd (NOT SCHED_FIFO/priority): on the single-core 400 MHz
#      AR9331, blanket real-time on the decode thread risks preempting the network
#      read that feeds it and self-deadlocking into an underrun. A negative nice
#      gives audio an edge over LED i2c churn / SSH without that risk. Matches the
#      shairport-sync treatment (see scripts/build.sh). Leave `priority` at 0.
#   3. player name falls back to the device hostname when unset, so the Beep shows
#      up in LMS/controllers under the same name as everywhere else.
#
# Audio goes to the ALSA "default" PCM (our softvol Master plug); close_delay (-C)
# releases the card a few seconds after playback so AirPlay/Snapcast can grab it,
# and so beepd's PCM-RUNNING check drops the "playing" LED animation when idle.

START=99
STOP=1

USE_PROCD=1
PROG=/usr/bin/squeezelite

make_cmdline() {
	cmdline=""

	local name
	config_get name options name ""
	# Fall back to the device hostname so the LMS player name tracks the Beep's name.
	[ -z "$name" ] && name="$(uci -q get system.@system[0].hostname)"
	[ -z "$name" ] && name="Beep"
	cmdline="$cmdline -n $name"

	local model_name
	config_get model_name options model_name "Beep"
	cmdline="$cmdline -M $model_name"

	local device
	config_get device options device "default"
	cmdline="$cmdline -o $device"

	# Bind squeezelite's volume to the shared ALSA softvol control (usually "Master")
	# so LMS volume == knob == web == LED arc. Empty = fall back to internal SW volume.
	local mixer_control
	config_get mixer_control options mixer_control ""
	[ -n "$mixer_control" ] && cmdline="$cmdline -V $mixer_control"

	local alsa_buffer
	config_get alsa_buffer options alsa_buffer 200
	[ "$alsa_buffer" -eq 0 ] && alsa_buffer="200"

	local alsa_period
	config_get alsa_period options alsa_period 4
	[ "$alsa_period" -eq 0 ] && alsa_period="4"

	local alsa_format
	config_get alsa_format options alsa_format 16
	[ "$alsa_format" = "0" ] && alsa_format="16"

	local alsa_mmap
	config_get alsa_mmap options alsa_mmap 0
	cmdline="$cmdline -a $alsa_buffer:$alsa_period:$alsa_format:$alsa_mmap"

	# Close the ALSA device after N idle seconds so other sources (AirPlay/Snapcast)
	# can open it, and so the LED "playing" animation clears when nothing is playing.
	local close_delay
	config_get close_delay options close_delay 5
	[ "$close_delay" -ne 0 ] && cmdline="$cmdline -C $close_delay"

	# Optional explicit server; empty = auto-discover the LMS instance on the LAN.
	local server_addr
	config_get server_addr options server_addr ""
	[ -n "$server_addr" ] && {
		local server_port
		config_get server_port options server_port 3483
		cmdline="$cmdline -s $server_addr:$server_port"
	}
}

start_service() {
	config_load squeezelite

	local enabled
	config_get_bool enabled options 'enabled' 0
	[ "$enabled" -eq 0 ] && return

	make_cmdline

	procd_open_instance
	logger -t 'squeezelite' "$cmdline"
	procd_set_param command "$PROG" $cmdline
	# Scheduling edge for the audio thread on the single-core AR9331 (see header).
	procd_set_param nice -12
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger squeezelite
}

# Wait for the previous instance to release its sockets before restarting.
reload_service() {
	stop
	sleep 2
	start
}

restart() {
	reload_service
}
