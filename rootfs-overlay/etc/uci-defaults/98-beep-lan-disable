#!/bin/sh
# Disable the stock `lan` interface (`br-lan`) — this device has NO wired LAN.
#
# The Beep is Wi-Fi only: the AR9331's ethernet MAC isn't wired to anything on the
# board, so the stock OpenWrt `lan` bridge (`br-lan`, static 192.168.1.1/24 over eth0)
# serves no purpose here — nothing can ever reach it. Worse, it actively BREAKS Wi-Fi:
# once the client STA (`wwan`) joins a home network that is itself 192.168.1.0/24 (one
# of the two most common home-router defaults), the box has two interfaces on the same
# subnet. The kernel then answers ARP/replies out `br-lan` (which goes nowhere) instead
# of the STA, so the device associates and gets a DHCP lease — it shows up in the
# router's client list — but is unpingable and its web UI/AirPlay are unreachable.
# Requests arrive; replies never route back. (Reported on the Lyrion forum: joined
# fine, visible with an IP, but no ping and no config portal — root cause was
# `br-lan` and `phy0-sta0` sharing 192.168.1.0/24.)
#
# Since `lan` is never needed on this hardware, disable it outright at first boot. This
# removes the collision on ANY home subnet, not just non-192.168.1.x ones. The `lan`
# firewall ZONE is untouched (it still carries `wwan`/`beepap` — see 99-beep-firewall),
# so reachability is unaffected; we only stop the unused bridge from coming up.
# Idempotent; resolves the interface BY NAME so a customized network config is safe.
if [ -n "$(uci -q get network.lan)" ] && [ "$(uci -q get network.lan.disabled)" != "1" ]; then
	uci -q set network.lan.disabled='1'
	uci -q commit network
fi
exit 0
