#!/bin/sh
# beep-group — apply this Beep's multi-room role. Model A (self-contained): the
# AirPlay-receiving Beep is the group PRIMARY (classic AirPlay-1 -> /tmp/snapfifo ->
# snapserver -> snapclients); every Beep runs snapclient and plays to the shared
# server timeline, so a group stays sample-accurately in sync. AirPlay-2 grouping
# can't run on this 400MHz silicon (AAC decode saturates the core) — Snapcast is
# the sync engine instead.
#
# Roles (uci: beep.main.group_role):
#   solo    - shairport -> ALSA directly (low latency, no snapcast). Default.
#   primary - shairport(AirPlay-1) -> pipe -> snapserver + local snapclient. Advertises.
#   member  - snapclient only; mDNS-discovers the primary (or beep.main.group_server).
#
# Usage: beep-group apply | primary | member | solo | toggle | status

SPCONF=/etc/shairport-sync.conf
FIFO=/tmp/snapfifo
RUNDIR=/var/run/beep

log() { logger -t beep-group "$*"; }

sp_backend() {  # $1 = alsa|pipe
	[ -f "$SPCONF" ] || return 0
	sed -i 's/output_backend = "[a-z]*";/output_backend = "'"$1"'";/' "$SPCONF"
	if [ "$1" = pipe ]; then
		grep -q '^pipe = {' "$SPCONF" || \
			printf '\npipe = {\n\tname = "%s";\n};\n' "$FIFO" >> "$SPCONF"
	fi
}

svc() { /etc/init.d/"$1" "$2" >/dev/null 2>&1; }

# Start/stop the AirPlay receiver per the uniform source switch (beep.sources.airplay,
# default ON). Lets `beep-source airplay off` survive a role re-apply. Members never
# receive AirPlay regardless, so they call svc directly instead of this.
sp_apply() {
	if [ "$(uci -q get beep.sources.airplay 2>/dev/null || echo 1)" = 0 ]; then
		svc shairport-sync disable; svc shairport-sync stop
	else
		svc shairport-sync enable;  svc shairport-sync restart
	fi
}

# NOTE: the Snapcast engine (apply_solo/apply_primary/apply_member) has been RETIRED —
# replaynet fully replaces it and snapcast is no longer built into the image. The engine
# selector below is now `replaynet` (AirPlay 1 multi-room) or `none` (AirPlay 2 native).

role="${1:-apply}"
[ "$role" = apply ] && role="$(uci -q get beep.main.group_role || echo solo)"

# --- multi-room ENGINE selector (default: snapcast, unchanged below) -----------------
# beep.main.group_engine = snapcast (default) | replaynet. The replaynet engine replaces
# snapserver+snapclient with the single `replaynet --node` daemon (consensus + fan-out;
# docs/REPLAYNET.md). Roles map onto its control socket; shairport pipes decoded PCM to
# the node FIFO and fires become-source/leave from its session hooks.
ENGINE="$(uci -q get beep.main.group_engine 2>/dev/null || echo replaynet)"
RN=/usr/sbin/replaynet
RNFIFO=/tmp/beep-pcm
AVOL=/usr/libexec/beep/beep-airplay-volume

# The pipe backend has no ALSA mixer, so (unlike the alsa backend) shairport can't bind
# AirPlay volume to the shared "Master" softvol — the web UI + LED arc (which read Master)
# stop tracking the phone's volume. Restore it with shairport's volume hook mapping AirPlay
# volume onto Master, and set ignore_volume_control so shairport does NOT also attenuate the
# pipe PCM in software (Master is the single volume control; no double attenuation).
# $1 = on (add, pipe path) | off (remove, alsa/direct path — the mixer handles volume there).
sp_airplay_vol_hook() {
	[ -f "$SPCONF" ] || return 0
	sed -i '/run_this_when_volume_is_set/d; /ignore_volume_control/d' "$SPCONF"   # start clean
	[ "$1" = on ] || return 0
	sed -i '/^general = {/a\	ignore_volume_control = "yes";' "$SPCONF"
	sed -i '/^general = {/a\	run_this_when_volume_is_set = "'"$AVOL"'";' "$SPCONF"
}

sp_replaynet() {  # point shairport-sync at replaynet: pipe -> FIFO + play/stop hooks
	[ -f "$SPCONF" ] || return 0
	sed -i 's/output_backend = "[a-z]*";/output_backend = "pipe";/' "$SPCONF"
	grep -q '^pipe = {' "$SPCONF" || printf '\npipe = {\n\tname = "%s";\n};\n' "$RNFIFO" >> "$SPCONF"
	sed -i '/^pipe = {/,/^};/ s#name = "[^"]*";#name = "'"$RNFIFO"'";#' "$SPCONF"
	grep -q '^sessioncontrol = {' "$SPCONF" || printf \
		'\nsessioncontrol = {\n\trun_this_before_play_begins = "%s --ctl become-source";\n\trun_this_after_play_ends = "%s --ctl leave";\n};\n' \
		"$RN" "$RN" >> "$SPCONF"
	sp_airplay_vol_hook on
}

if [ "$ENGINE" = replaynet ]; then
	# snapcast is never the sync engine under replaynet.
	svc snapserver disable; svc snapserver stop
	svc snapclient disable; svc snapclient stop

	# ALWAYS-PIPE. The node + pipe engine stay UP whenever replaynet is the engine — even
	# solo — so forming/joining/leaving a group is a pure control-plane message (`--ctl`)
	# with NO shairport restart and NO output-backend flip. (The old solo<->group flip
	# restarted shairport-sync, which dropped the live AirPlay session = the audio gap on
	# join.) Solo self-sources over 127.0.0.1 via shairport's become-source play hook; a
	# join just repoints this node's sink at the active group. All sinks sit the same fixed
	# distance (RN_BUFFER_NS) behind the source, so the source's own room and the members
	# stay sample-aligned without any buffer change on join.
	#
	# rn_engine_ensure is IDEMPOTENT: it only touches uci/services/shairport when something
	# isn't already in the pipe posture, and restarts shairport ONLY on a real change — so a
	# double-tap on an already-running engine never restarts shairport (the seamless path).
	rn_engine_ensure() {
		_changed=0
		[ "$(uci -q get replaynet.node.enabled 2>/dev/null)" = 1 ] || {
			uci -q set replaynet.node.enabled=1; uci -q commit replaynet; _changed=1; }
		pidof replaynet >/dev/null 2>&1 || { svc replaynet enable; svc replaynet start; _changed=1; }
		if ! grep -q 'output_backend = "pipe"' "$SPCONF" 2>/dev/null || \
		   ! grep -q "$RNFIFO" "$SPCONF" 2>/dev/null; then
			sp_replaynet; _changed=1     # shairport -> /tmp/beep-pcm pipe + become-source/leave + vol hooks
		fi
		[ "$_changed" = 1 ] && sp_apply  # restart shairport ONLY when we actually changed its config
		return 0
	}

	case "$role" in
		primary) uci -q set beep.main.group_role=primary; uci -q commit beep
			rn_engine_ensure; "$RN" --ctl become-source >/dev/null 2>&1
			mkdir -p "$RUNDIR"; echo primary > "$RUNDIR/group"; echo primary ;;
		member)  uci -q set beep.main.group_role=member;  uci -q commit beep
			rn_engine_ensure; "$RN" --ctl join >/dev/null 2>&1
			mkdir -p "$RUNDIR"; echo member > "$RUNDIR/group"; echo member ;;
		solo)    uci -q set beep.main.group_role=solo;    uci -q commit beep
			# Engine STAYS up (always-pipe). Solo just stops following any other group; it
			# self-sources when it actually plays (shairport become-source hook). No restart.
			rn_engine_ensure; "$RN" --ctl leave >/dev/null 2>&1
			rm -f "$RUNDIR/group" 2>/dev/null; echo solo ;;
		toggle)  # double-tap: leave the group if in it, else join the active source.
			# Pure control-plane on both edges — no shairport restart, no gap in source audio.
			rn_engine_ensure
			if [ -f "$RUNDIR/group" ]; then
				uci -q set beep.main.group_role=solo;   uci -q commit beep
				"$RN" --ctl leave >/dev/null 2>&1
				rm -f "$RUNDIR/group" 2>/dev/null; echo solo
			else
				uci -q set beep.main.group_role=member; uci -q commit beep
				"$RN" --ctl join >/dev/null 2>&1
				mkdir -p "$RUNDIR"; echo member > "$RUNDIR/group"; echo member
			fi ;;
		status)  "$RN" --ctl status 2>/dev/null || echo "role=solo (replaynet engine idle)" ;;
		*) echo "usage: beep-group apply|primary|member|solo|toggle|status" >&2; exit 1 ;;
	esac
	exit 0
fi
# --- ENGINE = none : AirPlay-2-native (converged AP2 mode) + safe default ------------
# In AirPlay-2 mode shairport does its OWN multi-room grouping (Apple Home, PTP-synced)
# and plays straight to ALSA — there is NO local multi-room engine, and the AR9331 has
# no CPU headroom to run one alongside AAC decode. So: make sure replaynet is fully
# DOWN and out of the audio path, keep shairport direct-to-ALSA, and make the grouping
# gestures inert (AP2 grouping is driven from the phone, not the knob). This branch also
# serves as the safe default for any unrecognised engine. Snapcast has been retired
# (dropped from the image); its services are stopped defensively if ever present.
# beep-airplay-mode owns the shairport service_type / nqptp; here we only guarantee the
# local-engine posture. See beep-airplay-mode and docs/CONVERGED-IMAGE-DESIGN.md.
if [ "$(uci -q get replaynet.node.enabled 2>/dev/null)" = 1 ]; then
	"$RN" --ctl leave >/dev/null 2>&1
	uci -q set replaynet.node.enabled=0; uci -q commit replaynet
fi
svc replaynet disable; svc replaynet stop
svc snapserver disable 2>/dev/null; svc snapserver stop 2>/dev/null   # legacy: snapcast retired
svc snapclient disable 2>/dev/null; svc snapclient stop 2>/dev/null
sp_backend alsa            # shairport -> ALSA directly (AirPlay-2 native playback)
sp_airplay_vol_hook off    # the alsa backend drives Master via the mixer natively
# Strip any replaynet session hooks (become-source/leave) left over from AP1 mode, so an
# AP2 stream doesn't fire them at a now-dead replaynet control socket on every play.
[ -f "$SPCONF" ] && sed -i '/^sessioncontrol = {/,/^};/d' "$SPCONF"
rm -f "$RUNDIR/group" 2>/dev/null

case "$role" in
	toggle)  log "double-tap ignored in AirPlay-2 mode — grouping is controlled from the phone (Apple Home)"; echo ap2 ;;
	status)  echo "engine=ap2-native (shairport AirPlay-2, no local multi-room engine)" ;;
	*)       sp_apply; echo ap2 ;;   # ensure the AirPlay-2 receiver is up
esac
exit 0
