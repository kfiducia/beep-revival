#!/bin/sh
# led-stage <mode> [args] — paint one static frame on the STM8 ring.
#
# Why this exists: the light ring is driven by the STM8L151 MCU (i2c addr 0x23 on
# the bit-banged i2c-gpio bus, /dev/i2c-0), and our firmware only takes the ring
# over once `beepd` starts (init START=95 — effectively "boot done"). So today a
# hang anywhere before that (e.g. the 2026-09-08 first-boot config-restore brick)
# is invisible unless the earlier boot stages paint the ring themselves. This helper
# is the primitive they step through: the boot animator (led-boot-anim) calls it
# frame-by-frame to draw the smiley, the rising boot "wings", and the OTA fill.
#
# It writes the same 25-byte frame beepd does: reg 0x80 <- [led_1..led_24, ack].
# ack=0x00 (we are NOT requesting an input frame; beepd owns polling once it runs).
# Single color, linear brightness (the STM8 applies no gamma — matches beepd).
#
# SAFE BY DESIGN: a no-op unless the bus is actually up. Very early in preinit the
# i2c-gpio / i2c-dev modules may not be loaded yet, so /dev/i2c-0 won't exist — we
# just exit 0. Never blocks or fails boot. Only drive the ring at stages where
# beepd is NOT running (early boot, and during `upgrade` when services are down),
# so we never fight beepd for the bus.
BUS=0
DEV="/dev/i2c-${BUS}"
ADDR=0x23
REG=0x80
NLED=24
# logical->wire rotation. 0 = wire index == logical index. MUST match beepd.c's
# LED_ROT so the early-boot ring and beepd's ring agree on where 12 o'clock is
# (beepd bench-calibration: lighting wire 0 lands ~12:15 and runs clockwise, so no
# rotation is needed). Was 11 — a stale copy of beepd's OLD value that rotated the
# whole ring ~180 deg, so a "fill from 12" actually started at the bottom.
ROT=0

# Ring geometry (logical index 0..23: 0 = 12 o'clock, increasing clockwise) — the
# same calibration constants beepd uses, so the smiley here matches beepd's smiley.
LED_BOT=12      # 6 o'clock
EYE_L=20        # ~10 o'clock
EYE_R=3         # ~2 o'clock
# smile: 8 LEDs across the bottom, LED_BOT-4 .. LED_BOT+3 = indices 8..15.
SMILE_LO=8
SMILE_HI=15

command -v i2ctransfer >/dev/null 2>&1 || exit 0
[ -e "$DEV" ] || exit 0

mode="$1"
case "$mode" in
	smiley)   v=255 ;;                 # boot-OK happy face (two eyes + a bottom smile arc)
	failsafe) v=30 ;;                  # alternating warning ring
	off)      v=0 ;;
	# wings <k> <v> — symmetric bottom-to-top fill about the VERTICAL AXIS, which runs
	# between LEDs 11 and 12 (the pair straddling 6 o'clock — the same pair the idle
	# breathe/sleep dots use). k=0 lights that bottom pair {11,12}; each level adds one
	# LED per side (mirror pairs i / 23-i); k=11 lights the whole ring. Starting on the
	# 11/12 pair (not a single LED at 12) keeps the fan centred and un-crooked, and makes
	# the wings begin looking exactly like the resting dots.
	wings)    k="$2"; v="${3:-50}"
	          case "$k" in ''|*[!0-9]*) exit 0 ;; esac
	          [ "$k" -gt 11 ] && k=11 ;;
	# fill <n> <v> — light the first n (0..24) LEDs as one arc growing CLOCKWISE from
	# 12 o'clock. The frame the OTA animator steps through so the dial fills from the top.
	fill)     n="$2"; v="${3:-50}"
	          case "$n" in ''|*[!0-9]*) exit 0 ;; esac
	          [ "$n" -gt "$NLED" ] && n="$NLED" ;;
	*)        exit 0 ;;
esac

# Build the physical LED array (space-separated decimals) per mode, then rotate to wire.
i=0; phys=""
while [ "$i" -lt "$NLED" ]; do
	lit=0
	case "$mode" in
		smiley)   if [ "$i" -eq "$EYE_L" ] || [ "$i" -eq "$EYE_R" ] || \
		             { [ "$i" -ge "$SMILE_LO" ] && [ "$i" -le "$SMILE_HI" ]; }; then lit=1; fi ;;
		failsafe) [ $((i % 2)) -eq 0 ] && lit=1 ;;
		wings)    if [ "$i" -ge "$LED_BOT" ]; then d=$((i - LED_BOT)); else d=$((LED_BOT - 1 - i)); fi
		          [ "$d" -le "$k" ] && lit=1 ;;
		fill)     [ "$i" -lt "$n" ] && lit=1 ;;
		off)      lit=0 ;;
	esac
	[ "$lit" -eq 1 ] && phys="$phys $v" || phys="$phys 0"
	i=$((i + 1))
done
# shellcheck disable=SC2086
set -- $phys

wire=""; i=0
while [ "$i" -lt "$NLED" ]; do
	idx=$(( (i + ROT) % NLED + 1 ))
	eval "b=\${$idx}"
	wire="$wire $(printf '0x%02x' "$b")"
	i=$((i + 1))
done

# reg + 24 LEDs + 1 ack = 26 bytes in one write.
# shellcheck disable=SC2086
i2ctransfer -y "$BUS" "w$((NLED + 2))@${ADDR}" "$REG" $wire 0x00 >/dev/null 2>&1 || true
exit 0
