#!/bin/sh
# Continuous Wi-Fi watchdog. Keeps the client STA connected and falls back to
# the Beep-Setup AP (pulsing ring) whenever it can't associate — so a wrong
# password, a moved router, or a dead AP self-heals into reconfig mode with no
# UART. Runs under procd (see /etc/init.d/beep-netcheck).
GRACE=3        # consecutive failed checks before falling back to the AP
PERIOD=10      # seconds between checks

sta_ok() {
	local up ip
	up="$(ubus call network.interface.wwan status 2>/dev/null | jsonfilter -e '@.up')"
	[ "$up" = "true" ] || return 1
	ip="$(ubus call network.interface.wwan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address')"
	[ -n "$ip" ]
}
ap_up() { [ "$(uci -q get wireless.setup.disabled)" = "0" ]; }

# Guarantee the radio actually comes up. Cold boot on this ath9k SoC is racy: the PHY
# only registers ~24s in (EEPROM-calibration hotplug), and if netifd processed the
# wireless config before the PHY existed, wireless can silently never start — no
# phy0-* netdev is ever created, so the STA doesn't even TRY to associate and the ring
# spins forever with no self-heal (the 2026-09-08 "wifi never started at boot"
# failure — netifd brought up lan/wan but never the radio). radio_up is true once any
# wireless netdev exists; ensure_radio runs an idempotent `wifi up` ONLY when none
# does — so it never disrupts a live or mid-association radio — and never force-enables
# a radio that's deliberately disabled (fresh unit / no client configured).
radio_up()     { ls /sys/class/net/ 2>/dev/null | grep -q '^phy0-'; }
ensure_radio() {
	radio_up && return 0
	[ "$(uci -q get wireless.radio0.disabled)" = 1 ] && return 0
	logger -t beep-netcheck "radio not up (cold-boot race?) -> running 'wifi up'"
	wifi up 2>/dev/null
	sleep 8    # let netifd create the netdev before the next check
}

# set_wifi (and boot, below) drop this marker — a deadline in *uptime* seconds —
# when we are DELIBERATELY switching the single radio AP->STA. While it's live we
# must NOT fall back to the setup AP: the radio can't be AP+STA at once, so a
# premature fallback rips the radio out mid-handshake and the join never lands
# (proven live: with this fallback suppressed, the STA associates in ~3s). It
# self-expires, so a genuinely wrong password still returns to setup after the
# window. Monotonic uptime avoids a pre-NTP wall clock mis-expiring it.
joining() {
	local d now; d="$(cat /var/run/beep/joining 2>/dev/null)" || return 1
	case "$d" in ''|*[!0-9]*) return 1;; esac
	now="$(cut -d. -f1 /proc/uptime)"
	[ "$now" -lt "$d" ]
}

# net-state drives the ring (beepd reads it): "connecting" -> orbiting spinner,
# "connected" -> calm idle. AP-setup is signalled separately via led-mode.
set_net() { mkdir -p /var/run/beep 2>/dev/null; printf '%s' "$1" > /var/run/beep/net-state; }

set_net connecting   # we come up trying to associate
ensure_radio         # cold-boot guarantee: start the radio if netifd's racy boot bring-up missed it
# On boot with a configured STA, give the first (cold) association the same
# protected window the portal switch gets — a cold associate + DHCP on this SoC
# can outlast the base grace, and there's no set_wifi involved to drop the marker.
# Gate on mode=sta (a real provisioned client): OpenWrt's auto-generated default is
# mode=ap ssid='OpenWrt', so keying off a non-empty ssid falsely armed this for a
# fresh, unconfigured unit.
[ "$(uci -q get wireless.@wifi-iface[0].mode)" = sta ] && {
	mkdir -p /var/run/beep 2>/dev/null
	echo "$(( $(cut -d. -f1 /proc/uptime) + 90 ))" > /var/run/beep/joining; }
sleep 25       # let wifi + DHCP settle after boot before judging
fails=0
while :; do
	# SSH temporary-mode fail-secure. A temp window ends two ways:
	#  (a) it lapses while dropbear is still up -> disable+stop it (the expiry branch).
	#  (b) a reboot killed dropbear -- temp is deliberately never re-enabled on boot, so
	#      it never restarts -- yet ssh_mode=temp + ssh_expires persist in UCI. The
	#      uci-defaults collapse (99-beep-ssh) only runs on first boot/sysupgrade, NOT a
	#      plain reboot, so without this the admin panel keeps showing "temp / on until
	#      HH:MM" for a session that isn't actually running. This loop runs on every boot
	#      under procd, so reconcile here: temp means "started for a window", hence temp
	#      with no dropbear is a void window -> collapse to off.
	if [ "$(uci -q get beep.main.ssh_mode)" = temp ]; then
		if ! pidof dropbear >/dev/null 2>&1; then
			uci -q set beep.main.ssh_mode=off; uci -q delete beep.main.ssh_expires; uci -q commit beep
			logger -t beep "ssh: temp mode but dropbear not running (post-reboot?) -> off"
		else
			exp="$(uci -q get beep.main.ssh_expires)"
			case "$exp" in [0-9]*) [ "$(date +%s)" -ge "$exp" ] && {
				/etc/init.d/dropbear disable 2>/dev/null; /etc/init.d/dropbear stop 2>/dev/null
				uci -q set beep.main.ssh_mode=off; uci -q delete beep.main.ssh_expires; uci -q commit beep
				logger -t beep "ssh: temporary window expired -> disabled"; };; esac
		fi
	fi
	ensure_radio   # keep the radio up: re-start it if a cold-boot race (or a later drop) left it down
	# "Provisioned" == a real client STA. set_wifi (the portal join) sets iface[0]
	# mode=sta/network=wwan; a fresh/factory-reset unit instead carries OpenWrt's
	# auto-generated placeholder (mode=ap, ssid='OpenWrt'). The old `[ -z ssid ]`
	# test saw that non-empty 'OpenWrt' and NEVER took the setup branch, so a sealed
	# fresh unit never raised its reconfig AP. Key off mode=sta instead.
	mode="$(uci -q get wireless.@wifi-iface[0].mode)"
	if [ "$mode" != sta ]; then
		ap_up || /usr/libexec/beep/wifi-setup-enable    # no client STA -> (fresh/reset) setup AP
		sleep 15; continue
	fi
	if sta_ok; then
		fails=0
		rm -f /var/run/beep/joining 2>/dev/null         # landed -> normal watchdog resumes
		set_net connected
		ap_up && /usr/libexec/beep/wifi-setup-disable   # recovered -> drop the AP
		sleep 20
	elif joining; then
		# a deliberate AP->STA switch is in flight — give it the full window,
		# never fall back to the AP mid-association (that's what broke the join)
		fails=0
		set_net connecting
		sleep "$PERIOD"
	else
		# ANTI-DEAUTH — do NOT auto-raise the setup AP for a *configured* STA that
		# can't associate. The old fallback (wifi-setup-enable after GRACE failures)
		# let an attacker deauth a configured device into setup mode, then read the
		# MAC-derived code off the broadcast SSID and reconfigure it. Now we just keep
		# retrying the client; the owner deliberately enters setup by HOLDING THE KNOB
		# ~10s (beepd hold gesture -> beep-action hold -> wifi-setup-enable). First
		# boot (no ssid, above) still auto-starts setup — there's no STA to deauth then.
		fails=$((fails + 1))
		set_net connecting
		sleep "$PERIOD"
	fi
done
