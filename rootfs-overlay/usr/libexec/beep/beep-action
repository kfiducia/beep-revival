#!/bin/sh
# beep-action <gesture> [arg]   — called by beepd on each decoded gesture.
# Policy layer mapping physical gestures to actions. Edit freely; beepd does not
# need recompiling.
#
#   turn <delta>    knob rotated <delta> detents -> volume +/-      (FIXED)
#   tap             single tap                   -> configurable    (see below)
#   double_tap      double tap                   -> configurable    (see below)
#   phys_confirm    triple tap                   -> 60s unsigned-upload unlock (FIXED, security)
#   hold            release after >=10s hold     -> enter Wi-Fi setup mode      (FIXED, recovery)
#   factory_reset   release after >=30s hold     -> wipe config + reboot        (FIXED, recovery)
# (beepd fires hold/factory_reset ON RELEASE by duration, with a growing LED
#  "arming" ring, so neither triggers accidentally.)
#
# CONFIGURABLE gestures (tap, double_tap): the action is read from UCI
# `beep.gestures.<gesture>` (default `auto`). Values:
#   auto           source-aware default: LMS active -> tap=lms_playpause; else tap=mute.
#                  double_tap auto = group_toggle (LMS-next is not an auto default yet).
#   mute           soft mute/unmute the local Master softvol
#   lms_playpause  play/pause our LMS player (falls back to mute if LMS unreachable)
#   lms_next       next track on our LMS player (falls back to group_toggle)
#   group_toggle   join/leave the multi-room group (beep-group)
#   none           no-op
# The safety/recovery gestures above are deliberately NOT remappable. Multi-room
# join/leave is delegated to /usr/libexec/beep/beep-group; LMS control to
# /usr/libexec/beep/beep-lms-ctl.

GESTURE="$1"; ARG="$2"
NLEDS=24              # LED ring resolution == number of volume levels (1 LED per detent)
LOGT="beep-action"
# (testability) state dir is overridable so the gesture logic can be exercised off-device
# against a temp dir; unset on a unit, so this is byte-identical to the original /var/run/beep.
BEEP_RUN="${BEEP_RUN_DIR:-/var/run/beep}"

log() { logger -t "$LOGT" "$*"; }

# (testability) override the config tool so gesture resolution can be exercised off-device.
UCI="${BEEP_UCI:-uci}"

# Which source currently owns the speaker? LMS takes over when enabled (set_lms stops
# shairport/replaynet), so the persistent UCI flag is the authoritative signal.
active_source() {
	[ "$("$UCI" -q get squeezelite.options.enabled 2>/dev/null)" = 1 ] && echo lms || echo airplay
}

# Resolve a configurable gesture (tap|double_tap) to a concrete action. Reads
# beep.gestures.<gesture> (default `auto`), expanding `auto` to the source-aware default.
gesture_action() {
	local g a; g="$1"
	a="$("$UCI" -q get "beep.gestures.$g" 2>/dev/null)"
	[ -n "$a" ] || a=auto
	if [ "$a" = auto ]; then
		case "$g" in
			tap)        [ "$(active_source)" = lms ] && a=lms_playpause || a=mute ;;
			double_tap) a=group_toggle ;;   # LMS-next is intentionally NOT an auto default yet
			*)          a=none ;;
		esac
	fi
	echo "$a"
}

# ---- concrete gesture actions ------------------------------------------------
# Soft mute/unmute. The softvol "Master" has volume but NO mute switch, so
# `set Master toggle` is a silent no-op; the honest local equivalent is save-and-zero.
act_mute() {
	local cur prev
	cur="$(amixer -M get Master 2>/dev/null | sed -n 's/.*\[\([0-9]*\)%\].*/\1/p' | head -1)"
	case "$cur" in ''|*[!0-9]*) cur=0;; esac
	mkdir -p "$BEEP_RUN"
	if [ "$cur" -gt 0 ]; then
		echo "$cur" > "$BEEP_RUN/premute-vol"
		amixer -M -q set Master 0% 2>/dev/null
		echo 0 > "$BEEP_RUN/volume"
		: > "$BEEP_RUN/muted"            # flag: beepd shows the muted indicator
		log "mute: muted (was ${cur}%)"
	else
		prev="$(cat "$BEEP_RUN/premute-vol" 2>/dev/null)"
		case "$prev" in ''|*[!0-9]*|0) prev=30;; esac
		amixer -M -q set Master "${prev}%" 2>/dev/null
		echo "$prev" > "$BEEP_RUN/volume"
		rm -f "$BEEP_RUN/muted"
		log "mute: unmuted -> ${prev}%"
	fi
}

# Toggle multi-room membership (beep-group owns the engine). Joining is slow+silent
# for ~5s, so raise the "joining" ring up front; cancel it if the toggle was a LEAVE.
act_group_toggle() {
	local new
	mkdir -p "$BEEP_RUN"
	echo "$(( $(cut -d. -f1 /proc/uptime) + 10 ))" > "$BEEP_RUN/connecting" 2>/dev/null
	new="$(/usr/libexec/beep/beep-group toggle 2>/dev/null | tail -1)"
	case "$new" in solo|"") rm -f "$BEEP_RUN/connecting" 2>/dev/null ;; esac
	log "group_toggle: multi-room now ${new:-toggled}"
}

# LMS transport — fallback-safe: on ANY failure, degrade to a source-agnostic action
# so a gesture never silently does nothing.
act_lms_playpause() { /usr/libexec/beep/beep-lms-ctl playpause || { log "lms_playpause failed -> mute"; act_mute; }; }
act_lms_next()      { /usr/libexec/beep/beep-lms-ctl next      || { log "lms_next failed -> group_toggle"; act_group_toggle; }; }

# Dispatch a resolved action. $1 = action, $2 = originating gesture (for logs).
run_gesture_action() {
	case "$1" in
		mute)          act_mute ;;
		group_toggle)  act_group_toggle ;;
		lms_playpause) act_lms_playpause ;;
		lms_next)      act_lms_next ;;
		none)          log "$2: none (no-op)" ;;
		*)             log "$2: unknown action '$1' -> mute"; act_mute ;;
	esac
}

# (testability) sourcing with BEEP_ACTION_LIB=1 exposes the functions without dispatching.
if [ "${BEEP_ACTION_LIB:-0}" = 1 ]; then return 0; fi

case "$GESTURE" in
	turn)
		# Drive the ALSA softvol "Master" (see /etc/asound.conf). shairport binds
		# its AirPlay volume to the same control, so the knob moves local playback
		# AND AirPlay in lockstep — and the web slider reads the same level.
		# beepd calls us at most ~12x/s with the NET encoder motion in that window.
		# The optical encoder emits an UNRELIABLE count-per-detent (measured: 1 when
		# slow, more when bunched at speed), so we do NOT trust the magnitude — each
		# call = exactly ONE LED step in the direction turned. At normal speed detents
		# land in separate calls (1 detent = 1 LED); very fast spins are gently
		# rate-limited to the call cadence. Master is snapped to exact 1/NLEDS levels
		# so beepd's arc (round(pct*NLEDS/100)) advances exactly one LED per step.
		case "$ARG" in ''|*[!0-9-]*) exit 0;; esac
		[ "$ARG" -eq 0 ] && exit 0
		step=1; [ "$ARG" -lt 0 ] && step=-1
		# Read our last-known level from the state file — NOT `amixer get`. Per-detent
		# turns fire up to ~12x/s; forking amixer-get + logger each time spiked the CPU
		# and made audio choppy on the AR9331. One `amixer set` is the only fork here.
		cur="$(cat "$BEEP_RUN/volume" 2>/dev/null)"
		case "$cur" in ''|*[!0-9]*) cur="$(amixer -M get Master 2>/dev/null | sed -n 's/.*\[\([0-9]*\)%\].*/\1/p' | head -1)";; esac
		case "$cur" in ''|*[!0-9]*) cur=0;; esac
		lvl=$(( (cur * NLEDS + 50) / 100 + step ))   # current LED level +/- one step
		[ "$lvl" -lt 0 ] && lvl=0; [ "$lvl" -gt "$NLEDS" ] && lvl="$NLEDS"
		pct=$(( (lvl * 100 + NLEDS / 2) / NLEDS ))   # snap back to % for the DAC
		amixer -M -q set Master "${pct}%" 2>/dev/null
		echo "$pct" > "$BEEP_RUN/volume"           # beepd arc reads this (no per-detent logger)
		;;
	tap)
		# Configurable via beep.gestures.tap (default `auto`; see header). auto = LMS
		# play/pause when LMS is the active source, else mute. AirPlay transport can't be
		# driven from here (no back-channel to the sender — issue #7), hence mute there.
		run_gesture_action "$(gesture_action tap)" tap
		;;
	double_tap)
		# Configurable via beep.gestures.double_tap (default `auto` = group_toggle).
		run_gesture_action "$(gesture_action double_tap)" double_tap
		;;
	hold)
		# released after a >=10s hold (see beepd tiers) -> Wi-Fi reconfig AP
		log "hold(10s): entering wifi setup mode"
		/usr/libexec/beep/wifi-setup-enable
		;;
	factory_reset)
		# released after a >=30s hold -> wipe overlay config + reboot. Next boot
		# re-provisions (per-device code/cert) and comes up in setup mode.
		log "hold(30s): FACTORY RESET — wiping config and rebooting"
		jffs2reset -y -r
		;;
	phys_confirm)
		# triple-tap: prove PHYSICAL possession to unlock an UNSIGNED firmware
		# upload for 60s. This is the anti-remote-hack gate — the OTA CGI accepts
		# an unsigned image only while this fresh, short-lived flag exists, so a
		# remote attacker (even with a stolen admin session) cannot flash unsigned.
		log "triple-tap: opened 60s physical-presence window for unsigned upload"
		mkdir -p "$BEEP_RUN"
		echo $(( $(date +%s) + 60 )) > "$BEEP_RUN/phys-confirm"
		( sleep 60; rm -f "$BEEP_RUN/phys-confirm" ) >/dev/null 2>&1 &
		;;
	*)
		log "unknown gesture: $GESTURE"
		;;
esac
exit 0
