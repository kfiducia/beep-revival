#!/bin/sh
# beep-source — one uniform switch for every audio source on the Beep.
#
# The device ships ONE firmware with every source baked in; each is toggled
# independently and only costs RAM/CPU while it is actually running (flash is
# the only always-on cost). This is the single place to enable/disable/inspect
# them. Each source keeps its natural config home (no duplicated state to drift):
#
#   airplay   beep.sources.airplay        shairport-sync            default ON
#   snapcast  beep.main.group_role         snapserver / snapclient   role-based (solo = off)
#   lms       squeezelite.options.enabled  squeezelite (Lyrion/LMS)  default OFF (opt-in)
#
# Snapcast is not a plain boolean — multi-room needs a role (solo/primary/member),
# so `snapcast on` joins as a member and `snapcast off` returns to solo, both via
# beep-group. For primary/member specifically, use `beep-group` directly.
#
# Usage:
#   beep-source status
#   beep-source <airplay|snapcast|lms> <on|off>

svc()     { /etc/init.d/"$1" "$2" >/dev/null 2>&1; }
running() { pidof "$1" >/dev/null 2>&1 && echo up || echo down; }

norm() {  # accept on/off/1/0/enable/disable
	case "$1" in
		on|1|enable|enabled)   echo 1 ;;
		off|0|disable|disabled) echo 0 ;;
		*) echo "" ;;
	esac
}

airplay_set() {
	uci -q set beep.sources.airplay="$1"; uci -q commit beep
	if [ "$1" = 1 ]; then svc shairport-sync enable;  svc shairport-sync restart
	else                  svc shairport-sync disable; svc shairport-sync stop; fi
}

lms_set() {
	uci -q set squeezelite.options.enabled="$1"; uci -q commit squeezelite
	svc squeezelite restart
}

snapcast_set() {  # boolean wrapper over the role model (see beep-group for primary)
	if [ "$1" = 1 ]; then /usr/libexec/beep/beep-group member
	else                  /usr/libexec/beep/beep-group solo; fi
}

status() {
	ap=$(uci -q get beep.sources.airplay 2>/dev/null || echo 1)
	role=$(uci -q get beep.main.group_role 2>/dev/null || echo solo)
	lms=$(uci -q get squeezelite.options.enabled 2>/dev/null || echo 0)
	printf 'airplay   enabled=%s  running=%s\n' "$ap"  "$(running shairport-sync)"
	printf 'snapcast  role=%s  server=%s  client=%s\n' "$role" "$(running snapserver)" "$(running snapclient)"
	printf 'lms       enabled=%s  running=%s\n' "$lms" "$(running squeezelite)"
}

case "$1" in
	status|"") status ;;
	airplay|snapcast|lms)
		v=$(norm "$2")
		[ -z "$v" ] && { echo "usage: beep-source $1 on|off" >&2; exit 1; }
		case "$1" in
			airplay)  airplay_set  "$v" ;;
			snapcast) snapcast_set "$v" ;;
			lms)      lms_set      "$v" ;;
		esac
		;;
	*) echo "usage: beep-source status | <airplay|snapcast|lms> <on|off>" >&2; exit 1 ;;
esac
